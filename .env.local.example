# Isolated local environment for testing. Do not use an external database URL here.
POSTGRES_USER=rupmes_local
POSTGRES_PASSWORD=rupmes_local
POSTGRES_DB=rupmes_local
DATABASE_URL=postgresql+psycopg2://rupmes_local:rupmes_local@db:5432/rupmes_local

DB_PORT=55432
BACKEND_PORT=18011
FRONTEND_PORT=18080
PGADMIN_PORT=15050

PGADMIN_DEFAULT_EMAIL=admin@admin.local
PGADMIN_DEFAULT_PASSWORD=admin

VITE_API_URL=http://localhost:18011
VITE_TENANT_ID=
VITE_CSRF_COOKIE_NAME=rupmes_csrf
VITE_DEFAULT_LANG=es

WAIT_FOR_DB_ON_STARTUP=true
WAIT_FOR_DB_TIMEOUT=60
RUN_DB_MIGRATIONS=true
RUN_DB_SEED=true
FRONTEND_ORIGINS=http://localhost:18080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=480
SESSION_COOKIE_NAME=rupmes_session
CSRF_COOKIE_NAME=rupmes_csrf
MULTI_TENANT_ENABLED=false
DEFAULT_TENANT_ID=DEFAULT
PRODUCTION_INGEST_API_KEY=local-test-ingest-key
