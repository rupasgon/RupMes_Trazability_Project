[Unit]
Description=RupMES Edge local industrial dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rupmes-edge
Group=rupmes-edge
EnvironmentFile=/etc/rupmes-edge/secrets.env
WorkingDirectory=/opt/rupmes-edge
ExecStart=/opt/rupmes-edge/venv/bin/rupmes-edge dashboard --config /etc/rupmes-edge/config.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rupmes-edge

[Install]
WantedBy=multi-user.target
