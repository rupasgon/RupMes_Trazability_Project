{
  "name": "line_a_siemens_s7",
  "api": {
    "base_url": "https://api-rupmes.example.local",
    "endpoint": "/production-reports/ingest",
    "client_id": "${ENV:RUPMES_CLIENT_ID}",
    "api_key": "${ENV:RUPMES_API_KEY}",
    "verify_tls": true
  },
  "source": {
    "type": "s7",
    "s7_host": "192.168.10.70",
    "s7_rack": 0,
    "s7_slot": 1,
    "s7_variables": {
      "sequence_id": { "db_number": 10, "start": 0, "data_type": "uint32" },
      "serial_number": { "db_number": 10, "start": 4, "data_type": "string", "length": 20 },
      "result_code": { "db_number": 10, "start": 24, "data_type": "uint16" },
      "data_ready": { "db_number": 10, "start": 26, "data_type": "bool", "bit": 0 }
    },
    "s7_trigger_field": "data_ready",
    "s7_trigger_value": true,
    "date_field": "event_received_at",
    "id_field": "sequence_id",
    "checkpoint_mode": "sequence",
    "timestamp_source": "received_at"
  },
  "payload": {
    "required_fields": ["line_code", "serial_number", "result", "production_datetime"],
    "mappings": {
      "line_code": { "constant": "LINE-A" },
      "serial_number": { "source": "serial_number", "transform": "string" },
      "result": { "source": "result_code", "transform": "string", "value_map": { "1": "OK", "2": "NOK", "3": "SCRAP", "4": "REWORK" } },
      "production_datetime": { "source": "event_received_at", "transform": "datetime" },
      "source_system": { "constant": "LINE-A-S7" }
    }
  },
  "state": {
    "checkpoint_file": "production_connector/state/line_a_s7.json",
    "initial_value": "2026-01-01T00:00:00"
  },
  "runtime": {
    "poll_interval_seconds": 2,
    "log_level": "INFO",
    "dry_run": true,
    "stop_on_error": false
  }
}
